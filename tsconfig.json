{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "useUnknownInCatchVariables": true,
    "jsx": "react-jsx",
    "skipLibCheck": false,
    "noEmit": true,
    "types": ["node", "vitest/globals"],
    "paths": {
      "core/*": ["./02_proceso/core/*"],
      "workflows/*": ["./02_proceso/workflows/*"],
      "committees/*": ["./02_proceso/committees/*"],
      "agents/*": ["./02_proceso/agents/*"],
      "governance/*": ["./02_proceso/governance/*"],
      "types/*": ["./02_proceso/types/*"],
      "networks/*": ["./03_artefactos/networks/*"],
      "renderers/*": ["./03_artefactos/renderers/*"],
      "adapters/*": ["./03_artefactos/adapters/*"],
      "content/*": ["./03_artefactos/content/*"],
      "brand/*": ["./03_artefactos/brand/*"],
      "projects/*": ["./03_artefactos/projects/*"],
      "skills/*": ["./03_artefactos/skills/*"],
      "work/*": ["./03_artefactos/work/*"],
      "registries/*": ["./04_estado/registries/*"],
      "receipts/*": ["./04_estado/receipts/*"],
      "approvals/*": ["./04_estado/approvals/*"],
      "scripts/*": ["./05_verificacion/scripts/*"],
      "tests/*": ["./05_verificacion/tests/*"],
      "quality/*": ["./05_verificacion/quality/*"],
      "guardian/*": ["./05_verificacion/guardian/*"],
      "inbox/*": ["./00_inbox/*"],
      "docs/*": ["./01_intencion/docs/*"]
    }
  },
  "include": [
    "00_inbox/**/*.ts",
    "00_inbox/**/*.tsx",
    "01_intencion/**/*.ts",
    "01_intencion/**/*.tsx",
    "02_proceso/**/*.ts",
    "02_proceso/**/*.tsx",
    "03_artefactos/**/*.ts",
    "03_artefactos/**/*.tsx",
    "04_estado/**/*.ts",
    "04_estado/**/*.tsx",
    "05_verificacion/**/*.ts",
    "05_verificacion/**/*.tsx",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "coverage",
    "03_artefactos/projects/**/web/dist",
    "03_artefactos/skills/**",
    "03_artefactos/scripts/**",
    "adapters/**",
    "agents/**",
    "approvals/**",
    "brand/**",
    "committees/**",
    "content/**",
    "core/**",
    "docs/**",
    "governance/**",
    "guardian/**",
    "inbox/**",
    "networks/**",
    "projects/**",
    "quality/**",
    "receipts/**",
    "registries/**",
    "renderers/**",
    "scripts/**",
    "skills/**",
    "tests/**",
    "types/**",
    "work/**",
    "workflows/**"
  ]
}
