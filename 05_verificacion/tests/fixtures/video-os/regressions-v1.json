{
  "schemaVersion": "video-os-regressions-v1",
  "syntheticOnly": true,
  "cases": [
    {
      "id": "prompt-chain-too-long",
      "valid": false,
      "mutation": "six or more human prompt gates",
      "expectedError": "VIDEO_OS_PROMPT_BUDGET"
    },
    {
      "id": "missing-default-document",
      "valid": false,
      "mutation": "review receipt omitted from the standard package",
      "expectedError": "VIDEO_OS_DOCUMENT_SET"
    },
    {
      "id": "oversized-context-capsule",
      "valid": false,
      "mutation": "active-stage context exceeds its declared token budget",
      "expectedError": "VIDEO_OS_CONTEXT_BUDGET"
    },
    {
      "id": "overcensor-whole-frame",
      "valid": false,
      "mutation": "light privacy mode applies a whole-frame blur",
      "expectedError": "VIDEO_OS_PRIVACY_NOT_FIELD_LEVEL"
    },
    {
      "id": "frozen-speaker-intro",
      "valid": false,
      "mutation": "speaker introduction uses one repeated frame instead of source motion",
      "expectedError": "VIDEO_OS_FROZEN_SPEAKER"
    },
    {
      "id": "stale-build-manifest",
      "valid": false,
      "mutation": "build manifest points to a superseded spec hash",
      "expectedError": "VIDEO_OS_STALE_MANIFEST"
    },
    {
      "id": "secondary-before-principal",
      "valid": false,
      "mutation": "horizontal derivative starts before principal verification PASS",
      "expectedError": "VIDEO_OS_PRINCIPAL_NOT_VERIFIED"
    },
    {
      "id": "approved-draft-confusion",
      "valid": false,
      "mutation": "an automatic verifier grants HUMAN_APPROVED",
      "expectedError": "VIDEO_OS_HUMAN_GATE_REQUIRED"
    }
  ]
}
