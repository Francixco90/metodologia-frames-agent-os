    "check:skills-templates": "node --import tsx 02_proceso/workflows/skill-systems/generate-templates.ts",
    "skills:package": "node --import tsx 05_verificacion/scripts/skills-system-cli.ts package",
    "docs:generate": "node --import tsx 02_proceso/workflows/documentation/generate.ts --write",
    "inventory:generate": "node --import tsx 05_verificacion/scripts/generate-ecosystem-inventory.ts --write",
    "check:documentation-os": "node --import tsx 05_verificacion/scripts/check-documentation-os.ts",
    "host:generate": "node --import tsx 03_artefactos/host-adapters/generate-host-adapters.ts --write",
    "check:host-adapters": "node --import tsx 03_artefactos/host-adapters/generate-host-adapters.ts",
    "host:install": "node --import tsx 05_verificacion/scripts/install-host-adapter.ts",
    "brand:generate": "node --import tsx scripts/generate-brand-projections.ts",
    "ledger:generate": "node --import tsx scripts/generate-file-disposition-ledger.ts --write",
    "carousel:build": "node --import tsx scripts/build-carousel-pilot.ts",
    "carousel:render": "node --import tsx renderers/static-social/scripts/render-carousel.ts",
    "carousel:orchestrate": "node --import tsx scripts/build-carousel-orchestration-run.ts",
    "cb": "node --import tsx skills/metodologia-certificate-builder/scripts/render-certificates.ts",
    "cv": "node --import tsx skills/metodologia-certificate-builder/scripts/validate-certificates.ts",
    "creation-doc:build": "node --import tsx scripts/build-creation-doc.ts",
    "verify:creation-doc": "node --import tsx scripts/check-creation-doc.ts",
    "atoms:build": "node --import tsx scripts/build-content-atoms.ts",
    "verify:atoms": "node --import tsx scripts/check-content-atoms.ts",
    "verify:renderers": "node --import tsx scripts/check-renderer-capabilities.ts",
    "verify:docs": "node --import tsx scripts/check-docs.ts",
    "verify:brand": "node --import tsx scripts/check-brand.ts",
    "verify:orchestration": "node --import tsx scripts/check-orchestration.ts",
    "verify:carousel": "node --import tsx scripts/check-carousel.ts",
    "verify:content-matrix": "node --import tsx scripts/check-content-matrix.ts",
    "verify:skills": "node --import tsx scripts/check-instagram-v2-skills.ts && node --import tsx scripts/check-creation-v3-skills.ts && node --import tsx scripts/reconcile-skill-registries.ts && pnpm check:skills-templates",
    "verify:content-os": "node --import tsx scripts/check-content-os-workflows.ts",
    "verify:career-design": "node 03_artefactos/skills/career-design-system/scripts/check-skill.mjs && node 03_artefactos/brand/career-design-system/scripts/build-options.mjs --check && vitest run tests/unit/career-design-*.test.ts",
    "verify:career": "node --import tsx scripts/check-career-workflows.ts && vitest run tests/unit/career-*.test.ts tests/integration/career-*.test.ts",
    "video-os": "node --import tsx 02_proceso/workflows/video-os/_runner/video-os.ts",
    "verify:video-os": "node --import tsx 05_verificacion/scripts/check-video-os.ts && vitest run 05_verificacion/tests/unit/video-os-*.test.ts",
    "verify:contributions": "node --import tsx scripts/check-contributions.ts",
    "verify:dependencies": "node --import tsx scripts/check-dependency-audit.ts",
    "committee:validate": "node --import tsx projects/vs-001-source-to-campaign/remotion/committee/validate-committee.ts",
    "content:build": "node --import tsx workflows/content/build.ts",
    "web:build": "node --import tsx workflows/web/build.ts",
    "web:smoke": "node scripts/web-visual-smoke.mjs",
    "web:review": "pnpm web:build && pnpm web:smoke",
    "remotion:prepare": "node --import tsx renderers/remotion/scripts/prepare-project.ts",
    "remotion:validate": "node --import tsx renderers/remotion/scripts/validate-project.ts",
    "render:all": "node --import tsx renderers/remotion/scripts/render-project.ts",
    "remotion:inspect": "node --import tsx renderers/remotion/scripts/inspect-renders.ts",
    "slice:build": "node --import tsx scripts/build-vertical-slice.ts",
    "slice:verify-compat": "node --import tsx scripts/build-vertical-slice.ts --verify-existing",
    "verify:ai-runtime": "node --import tsx scripts/check-ai-runtime.ts",
    "verify:instructions": "pnpm docs:audit && pnpm check:context && pnpm check:host-adapters",
    "verify": "pnpm check:repo && pnpm check:atemporal && pnpm check:md-budgets && pnpm verify:instructions && pnpm verify:docs && pnpm verify:creation-doc && pnpm verify:atoms && pnpm verify:renderers && pnpm verify:brand && pnpm verify:orchestration && pnpm verify:carousel && pnpm verify:content-matrix && pnpm verify:skills && pnpm verify:content-os && pnpm verify:career-design && pnpm verify:career && pnpm verify:video-os && pnpm verify:multimedia && pnpm verify:ai-runtime && pnpm verify:dependencies && pnpm slice:verify-compat && pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "verify:media": "pnpm remotion:inspect",
    "verify:multimedia": "node --import tsx scripts/check-multimedia-capabilities.ts",
    "bootstrap": "pnpm install && pnpm check:toolchain",
    "doctor": "node --import tsx scripts/doctor.ts",
    "check": "pnpm check:toolchain && pnpm check:repo && pnpm check:atemporal && pnpm check:md-budgets && pnpm check:ownership && pnpm check:dag && pnpm check:tasks",
    "task:ongoing": "node --import tsx scripts/ongoing-projects.ts",
    "task:run-check": "node --import tsx scripts/run-check.ts",
    "report": "node --import tsx scripts/doctor.ts"
  },
