{
  "name": "metodologia-frames-agent-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OS agéntico creativo source-first y fail-closed para MetodologIA.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22.23.1",
    "pnpm": "11.9.0"
  },
  "toolchain": {
    "node": "22.23.1",
    "pnpm": "11.9.0",
    "remotion": "4.0.494",
    "zod": "4.3.6",
    "ffmpeg": "8.1.1",
    "playwright": "1.61.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "check:toolchain": "node --import tsx scripts/check-toolchain.ts",
    "check:dag": "node --import tsx scripts/check-dag.ts",
    "check:ownership": "node --import tsx scripts/check-ownership.ts",
    "check:projects": "node --import tsx scripts/check-projects.ts",
    "check:memory": "node --import tsx scripts/check-memory.ts",
    "check:notebooklm": "node --import tsx scripts/check-notebooklm.ts",
    "check:sources": "node --import tsx scripts/check-sources.ts",
    "check:claims": "node --import tsx scripts/check-claims.ts",
    "check:privacy": "node --import tsx scripts/check-privacy.ts",
    "check:determinism": "node --import tsx scripts/check-determinism.ts",
    "check:n8n": "node --import tsx scripts/check-n8n.ts",
    "check:repo": "node --import tsx scripts/check-repo.ts",
    "check:tasks": "node --import tsx scripts/check-tasks.ts",
    "check:env": "node --import tsx scripts/check-env-drift.ts",
    "task:backfill": "node --import tsx scripts/backfill-tasks.ts",
    "task:scaffold-continuity": "node --import tsx scripts/scaffold-continuity.ts",
