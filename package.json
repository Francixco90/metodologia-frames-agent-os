    "mw:render-schematics": "node --import tsx 02_proceso/workflows/multimedia/_runner/render-schematic-html.ts",
    "mw:scaffold-artifacts": "node --import tsx 05_verificacion/scripts/scaffold-artifact-schemas.ts",
    "eval:run": "node --import tsx 05_verificacion/evals/runner.ts",
    "ablation:run": "node --import tsx 05_verificacion/evals/ablation/runner.ts run",
    "ablation:report": "node --import tsx 05_verificacion/evals/ablation/runner.ts report",
    "check:grants": "node --import tsx 05_verificacion/scripts/check-tool-grants.ts",
    "check:atemporal": "node --import tsx 05_verificacion/scripts/check-atemporal.ts",
    "check:md-budgets": "node --import tsx 05_verificacion/scripts/check-md-budgets.ts",
    "docs:audit": "node --import tsx 05_verificacion/scripts/audit-markdown.ts",
    "context:generate": "node --import tsx 05_verificacion/scripts/generate-context-surfaces.ts --write",
    "check:context": "node --import tsx 05_verificacion/scripts/check-context-surfaces.ts",
    "frames:assist": "node 05_verificacion/scripts/frames-assist.mjs",
    "frames:extend": "node --import tsx 05_verificacion/scripts/frames-extend.ts",
    "skills:inspect": "node --import tsx 05_verificacion/scripts/skills-system-cli.ts inspect",
    "skills:scaffold": "node --import tsx 05_verificacion/scripts/skills-system-cli.ts scaffold",
    "skills:validate": "node --import tsx 05_verificacion/scripts/skills-system-cli.ts validate",
    "skills:evaluate": "node --import tsx 05_verificacion/scripts/skills-system-cli.ts evaluate",
