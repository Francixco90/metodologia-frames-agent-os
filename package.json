{
  "name": "metodologia-instagram-agent-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OS agéntico creativo source-first y fail-closed para MetodologIA.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.23.1 <25",
    "pnpm": "11.9.0"
  },
  "toolchain": {
    "node": "22.23.1",
    "pnpm": "11.9.0",
    "remotion": "4.0.494",
    "zod": "4.3.6",
    "ffmpeg": "8.1.1",
    "playwright": "1.61.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "vitest run tests/integration",
    "check:toolchain": "node --import tsx scripts/check-toolchain.ts",
    "check:dag": "node --import tsx scripts/check-dag.ts",
    "check:ownership": "node --import tsx scripts/check-ownership.ts",
    "check:projects": "node --import tsx scripts/check-projects.ts",
    "check:memory": "node --import tsx scripts/check-memory.ts",
    "check:notebooklm": "node --import tsx scripts/check-notebooklm.ts",
    "check:sources": "node --import tsx scripts/check-sources.ts",
    "check:claims": "node --import tsx scripts/check-claims.ts",
    "check:privacy": "node --import tsx scripts/check-privacy.ts",
    "check:determinism": "node --import tsx scripts/check-determinism.ts",
    "check:n8n": "node --import tsx scripts/check-n8n.ts",
    "check:repo": "node --import tsx scripts/check-repo.ts",
    "brand:generate": "node --import tsx scripts/generate-brand-projections.ts",
    "ledger:generate": "node --import tsx scripts/generate-file-disposition-ledger.ts --write",
    "carousel:build": "node --import tsx scripts/build-carousel-pilot.ts",
    "carousel:render": "node --import tsx renderers/static-social/scripts/render-carousel.ts",
    "carousel:orchestrate": "node --import tsx scripts/build-carousel-orchestration-run.ts",
    "creation-doc:build": "node --import tsx scripts/build-creation-doc.ts",
    "verify:creation-doc": "node --import tsx scripts/check-creation-doc.ts",
    "atoms:build": "node --import tsx scripts/build-content-atoms.ts",
    "verify:atoms": "node --import tsx scripts/check-content-atoms.ts",
    "verify:docs": "node --import tsx scripts/check-docs.ts",
    "verify:brand": "node --import tsx scripts/check-brand.ts",
    "verify:orchestration": "node --import tsx scripts/check-orchestration.ts",
    "verify:carousel": "node --import tsx scripts/check-carousel.ts",
    "verify:content-matrix": "node --import tsx scripts/check-content-matrix.ts",
    "verify:skills": "node --import tsx scripts/check-instagram-v2-skills.ts",
    "verify:dependencies": "node --import tsx scripts/check-dependency-audit.ts",
    "committee:validate": "node --import tsx projects/vs-001-source-to-campaign/remotion/committee/validate-committee.ts",
    "content:build": "node --import tsx workflows/content/build.ts",
    "web:build": "node --import tsx workflows/web/build.ts",
    "remotion:prepare": "node --import tsx renderers/remotion/scripts/prepare-project.ts",
    "remotion:validate": "node --import tsx renderers/remotion/scripts/validate-project.ts",
    "render:all": "node --import tsx renderers/remotion/scripts/render-project.ts",
    "remotion:inspect": "node --import tsx renderers/remotion/scripts/inspect-renders.ts",
    "slice:build": "node --import tsx scripts/build-vertical-slice.ts",
    "slice:verify-compat": "node --import tsx scripts/build-vertical-slice.ts --verify-existing",
    "verify": "pnpm check:repo && pnpm verify:docs && pnpm verify:creation-doc && pnpm verify:atoms && pnpm verify:brand && pnpm verify:orchestration && pnpm verify:carousel && pnpm verify:content-matrix && pnpm verify:skills && pnpm verify:dependencies && pnpm slice:verify-compat && pnpm typecheck && pnpm lint && pnpm test && pnpm format:check",
    "verify:media": "pnpm remotion:inspect"
  },
  "dependencies": {
    "@remotion/zod-types": "4.0.494",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "remotion": "4.0.494",
    "yaml": "2.9.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@remotion/bundler": "4.0.494",
    "@remotion/cli": "4.0.494",
    "@remotion/renderer": "4.0.494",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "10.7.0",
    "playwright": "1.61.1",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vitest": "4.1.10"
  }
}
