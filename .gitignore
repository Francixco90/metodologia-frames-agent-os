# task-isolated harness scratch (S13)
# Scratch paths (ignored, never committed)
04_estado/tasks/*/work/**
04_estado/tasks/*/runtime/**
04_estado/tasks/*/continuity/state.yaml
04_estado/tasks/*/*.tmp
# Canonical paths (force-tracked, ensure not ignored)
