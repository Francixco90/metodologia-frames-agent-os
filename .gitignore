!04_estado/tasks/*/PROGRESS.md
!04_estado/tasks/*/meta/**
!04_estado/tasks/*/context/**
!04_estado/tasks/*/inputs/**
!04_estado/tasks/*/checks/**
!04_estado/tasks/*/artifacts/**
