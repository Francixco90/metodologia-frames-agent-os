{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "talking-head-recut-v2",
  "title": "Spec First talking-head recut",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "operation", "specId", "specSha256", "compositionId", "durationSeconds",
    "clip", "scriptMode", "correctionLedgerRef", "transcriptIntelligenceRef",
    "semanticIndexRef", "narrativeMapRef", "sourceAnalysisRef", "sourceAnalysisSha256", "visualBudgetRef", "visualBudgetSha256", "brandKitRef", "brandKitSha256", "layoutDecision", "reelSpec", "verificationState", "editorialDecision", "cards"
  ],
  "properties": {
    "schemaVersion": {"const": "talking-head-recut-v2"},
    "operation": {"enum": ["read", "plan", "render-draft"]},
    "specId": {"type": "string", "minLength": 1},
    "specSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "compositionId": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "durationSeconds": {"type": "number", "minimum": 1},
    "clip": {"type": "object", "required": ["ref", "sha256"]},
    "scriptMode": {"const": "assembly_map"},
    "captionTrackRef": {"type": "string"},
    "correctionLedgerRef": {"type": "string", "minLength": 1},
    "transcriptIntelligenceRef": {"type": "string", "minLength": 1},
    "semanticIndexRef": {"type": "string", "minLength": 1},
    "narrativeMapRef": {"type": "string", "minLength": 1},
    "sourceAnalysisRef": {"type": "string", "minLength": 1},
    "sourceAnalysisSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "visualBudgetRef": {"type": "string", "minLength": 1},
    "visualBudgetSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "brandKitRef": {"type": "string", "minLength": 1},
    "brandKitSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "layoutDecision": {"type": "object", "additionalProperties": false, "required": ["route", "cropSafeEvidence"], "properties": {"route": {"enum": ["contain", "crop-safe", "reject"]}, "cropSafeEvidence": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "reelSpec": {"type": "object", "additionalProperties": false, "required": ["purpose", "audience", "hook", "evidence", "impact", "cta", "targetDurationSeconds"], "properties": {"purpose": {"type": "string", "minLength": 1}, "audience": {"type": "string", "minLength": 1}, "hook": {"type": "string", "minLength": 1}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "impact": {"type": "string", "minLength": 1}, "cta": {"type": "string", "minLength": 1}, "targetDurationSeconds": {"type": "number", "minimum": 10}}},
    "verificationState": {"enum": ["deterministic-passed", "human-reviewed"]},
    "editorialDecision": {"enum": ["use", "extend", "reframe", "discard"]},
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "startSeconds", "endSeconds", "kind", "content", "rationale", "evidenceRef", "sourceSpan"],
        "properties": {
          "id": {"type": "string", "pattern": "^card-\\d{2}$"},
          "startSeconds": {"type": "number", "minimum": 0},
          "endSeconds": {"type": "number", "exclusiveMinimum": 0},
          "kind": {"enum": ["title", "lower-third", "data-callout", "quote", "side-panel", "pip"]},
          "content": {"type": "string"},
          "rationale": {"type": "string"},
          "evidenceRef": {"type": "string"},
          "sourceSpan": {"$ref": "#/$defs/sourceSpan"},
          "visualSpan": {"$ref": "#/$defs/sourceSpan"}
        },
        "allOf": [{"if": {"properties": {"kind": {"const": "pip"}}}, "then": {"required": ["visualSpan"]}}]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"operation": {"const": "render-draft"}}, "required": ["operation"]},
      "then": {"properties": {
        "editorialDecision": {"const": "use"},
        "layoutDecision": {"properties": {"route": {"enum": ["contain", "crop-safe"]}}}
      }}
    },
    {
      "if": {"properties": {"layoutDecision": {"properties": {"route": {"const": "crop-safe"}}}}},
      "then": {"properties": {"layoutDecision": {"properties": {"cropSafeEvidence": {"minItems": 1}}}}}
    }
  ],
  "$defs": {
    "sourceSpan": {
      "type": "object",
      "required": ["sourceId", "startSeconds", "endSeconds", "absolute", "local"],
      "properties": {
        "sourceId": {"type": "string"},
        "startSeconds": {"type": "number"},
        "endSeconds": {"type": "number"},
        "absolute": {"type": "object", "additionalProperties": false, "required": ["clockId", "startSeconds", "endSeconds"], "properties": {"clockId": {"type": "string", "minLength": 1}, "startSeconds": {"type": "number", "minimum": 0}, "endSeconds": {"type": "number", "exclusiveMinimum": 0}}},
        "local": {"type": "object", "additionalProperties": false, "required": ["clockId", "startSeconds", "endSeconds"], "properties": {"clockId": {"type": "string", "minLength": 1}, "startSeconds": {"type": "number", "minimum": 0}, "endSeconds": {"type": "number", "exclusiveMinimum": 0}}}
      }
    }
  }
}
