{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "precomposed-frame-manifest-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "adapterId", "framePattern", "frameCount", "frames", "framesSha256", "cleanup", "generator", "audio", "derivationSha256"],
  "properties": {
    "schemaVersion": {"const": "precomposed-frame-manifest-v1"},
    "adapterId": {"const": "precomposed-frames-v1"},
    "framePattern": {"type": "string", "pattern": "%0[1-9]d"},
    "frameCount": {"type": "integer", "minimum": 1},
    "frames": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["index", "ref", "sha256"], "properties": {"index": {"type": "integer", "minimum": 0}, "ref": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}}},
    "framesSha256": {"$ref": "#/$defs/hash"},
    "cleanup": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256", "order"], "properties": {"ref": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}, "order": {"const": "cleanup-before-treatment"}}},
    "generator": {"type": "object", "additionalProperties": false, "required": ["id", "version", "configRef", "configSha256", "deterministic"], "properties": {"id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "configRef": {"type": "string", "minLength": 1}, "configSha256": {"$ref": "#/$defs/hash"}, "deterministic": {"const": true}}},
    "audio": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": {"ref": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}},
    "derivationSha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
