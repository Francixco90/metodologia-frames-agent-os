{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "general-video-case-longform-adapter-v1",
  "oneOf": [
    {"$ref": "#/$defs/adapter"},
    {"$ref": "#/$defs/authorityBundle"}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "sha256", "bytes"],
      "properties": {
        "ref": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/hash"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "kind", "archetype", "mode", "disposition", "authority", "allowedCommands", "blockedCommands", "effects", "coverageGap"],
      "properties": {
        "schemaVersion": {"const": "general-video-case-longform-adapter-v1"},
        "kind": {"const": "case_longform_authority_adapter"},
        "archetype": {"const": "case-longform"},
        "mode": {"const": "PLAN_VERIFY_ONLY"},
        "disposition": {"const": "USE"},
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["jobId", "sourceSetSha256", "status", "contract", "executionLedger", "externalReviewPlan"],
          "properties": {
            "jobId": {"type": "string", "minLength": 1},
            "sourceSetSha256": {"$ref": "#/$defs/hash"},
            "status": {"enum": ["PRE_RENDER_BLOCKED", "BLOCKED_PENDING_V7C_FULL_CHAIN_FIXTURE_AND_CAPTION_VISUAL_EVIDENCE_CONTRACTS"]},
            "contract": {"$ref": "#/$defs/ref"},
            "executionLedger": {"$ref": "#/$defs/ref"},
            "externalReviewPlan": {"$ref": "#/$defs/ref"}
          }
        },
        "allowedCommands": {"const": ["plan", "verify"]},
        "blockedCommands": {"const": ["ingest", "index", "script", "render", "package"]},
        "effects": {"const": false},
        "coverageGap": {"const": "V7C_FULL_CHAIN_FIXTURE_NOT_ACCREDITED"},
        "doNotUseRefs": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true, "default": []}
      }
    },
    "actors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layout_authority", "compositor_authority", "caption_verifier"],
      "properties": {
        "layout_authority": {"$ref": "#/$defs/id"},
        "compositor_authority": {"$ref": "#/$defs/id"},
        "caption_verifier": {"$ref": "#/$defs/id"}
      }
    },
    "reviewActors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planner", "caption_verifier", "guardian"],
      "properties": {
        "planner": {"$ref": "#/$defs/id"},
        "caption_verifier": {"$ref": "#/$defs/id"},
        "guardian": {"$ref": "#/$defs/id"}
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio_dictionary_receipt", "audio_redaction_map", "audio_transcript", "caption_cleanup", "caption_compositor_authority", "caption_execution_ledger", "caption_external_review_plan", "caption_layout_authority", "caption_placement_plan", "caption_track", "caption_verifier_authority", "compiler", "frame_diff_ledger", "operation_graph", "plan", "preflight", "preservation_plan", "preservation_policy_receipt", "preview_media", "redaction_map", "runner", "semantic_claim_map", "semantic_policy_receipt", "semantic_policy_receipt_v2", "semantic_policy_receipt_v3", "source_segment_map", "source_set", "temporal_map", "transform_order"],
      "properties": {
        "audio_dictionary_receipt": {"$ref": "#/$defs/ref"},
        "audio_redaction_map": {"$ref": "#/$defs/ref"},
        "audio_transcript": {"$ref": "#/$defs/ref"},
        "caption_cleanup": {"$ref": "#/$defs/ref"},
        "caption_compositor_authority": {"$ref": "#/$defs/ref"},
        "caption_execution_ledger": {"$ref": "#/$defs/ref"},
        "caption_external_review_plan": {"$ref": "#/$defs/ref"},
        "caption_layout_authority": {"$ref": "#/$defs/ref"},
        "caption_placement_plan": {"$ref": "#/$defs/ref"},
        "caption_track": {"$ref": "#/$defs/ref"},
        "caption_verifier_authority": {"$ref": "#/$defs/ref"},
        "compiler": {"$ref": "#/$defs/ref"},
        "frame_diff_ledger": {"$ref": "#/$defs/ref"},
        "operation_graph": {"$ref": "#/$defs/ref"},
        "plan": {"$ref": "#/$defs/ref"},
        "preflight": {"$ref": "#/$defs/ref"},
        "preservation_plan": {"$ref": "#/$defs/ref"},
        "preservation_policy_receipt": {"$ref": "#/$defs/ref"},
        "preview_media": {"$ref": "#/$defs/ref"},
        "redaction_map": {"$ref": "#/$defs/ref"},
        "runner": {"$ref": "#/$defs/ref"},
        "semantic_claim_map": {"$ref": "#/$defs/ref"},
        "semantic_policy_receipt": {"$ref": "#/$defs/ref"},
        "semantic_policy_receipt_v2": {"$ref": "#/$defs/ref"},
        "semantic_policy_receipt_v3": {"$ref": "#/$defs/ref"},
        "source_segment_map": {"$ref": "#/$defs/ref"},
        "source_set": {"$ref": "#/$defs/ref"},
        "temporal_map": {"$ref": "#/$defs/ref"},
        "transform_order": {"$ref": "#/$defs/ref"}
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "job_id", "source_set_sha256", "artifacts", "caption_actors", "v4_status", "v5a_status", "v6_status", "v7a_status", "v7b_status", "planned_review_authority_root", "prior_authority_roots", "review_actors", "coverage_gap", "status"],
      "properties": {
        "schema_version": {"const": "case-longform-caption-review-plan-contract-v7c0"},
        "job_id": {"type": "string", "minLength": 1},
        "source_set_sha256": {"$ref": "#/$defs/hash"},
        "artifacts": {"$ref": "#/$defs/artifacts"},
        "caption_actors": {"$ref": "#/$defs/actors"},
        "v4_status": {"enum": ["PRE_RENDER_BLOCKED", "BLOCKED_PENDING_PRESERVATION_AND_EXTERNAL_REVIEW_CONTRACTS"]},
        "v5a_status": {"const": "BLOCKED_PENDING_RGB_DIFF_LEDGER_CONTRACTS"},
        "v6_status": {"const": "BLOCKED_PENDING_CAPTION_AND_EXTERNAL_REVIEW_CONTRACTS"},
        "v7a_status": {"enum": ["PRE_RENDER_BLOCKED", "BLOCKED_PENDING_CAPTION_MATERIAL_LEDGER_CONTRACTS"]},
        "v7b_status": {"enum": ["PRE_RENDER_BLOCKED", "BLOCKED_PENDING_CAPTION_VISUAL_EVIDENCE_CONTRACTS"]},
        "planned_review_authority_root": {"type": "string", "minLength": 1},
        "prior_authority_roots": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "review_actors": {"$ref": "#/$defs/reviewActors"},
        "coverage_gap": {"const": "V7C_FULL_CHAIN_FIXTURE_NOT_ACCREDITED"},
        "status": {"enum": ["PRE_RENDER_BLOCKED", "BLOCKED_PENDING_V7C_FULL_CHAIN_FIXTURE_AND_CAPTION_VISUAL_EVIDENCE_CONTRACTS"]}
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "cue_id", "layout_id", "start_frame", "end_frame", "text_sha256", "font_sha256", "geometry", "graph_sha256", "temporal_map_sha256", "caption_track_sha256", "caption_cleanup_sha256", "layout_authority_sha256", "compositor_authority_sha256", "compositor_executable_sha256", "compositor_command_sha256", "compositor_config_sha256", "previous_entry_sha256", "entry_sha256"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0},
        "cue_id": {"$ref": "#/$defs/id"},
        "layout_id": {"$ref": "#/$defs/id"},
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame": {"type": "integer", "minimum": 0},
        "text_sha256": {"$ref": "#/$defs/hash"},
        "font_sha256": {"$ref": "#/$defs/hash"},
        "geometry": {"$ref": "#/$defs/geometry"},
        "graph_sha256": {"$ref": "#/$defs/hash"},
        "temporal_map_sha256": {"$ref": "#/$defs/hash"},
        "caption_track_sha256": {"$ref": "#/$defs/hash"},
        "caption_cleanup_sha256": {"$ref": "#/$defs/hash"},
        "layout_authority_sha256": {"$ref": "#/$defs/hash"},
        "compositor_authority_sha256": {"$ref": "#/$defs/hash"},
        "compositor_executable_sha256": {"$ref": "#/$defs/hash"},
        "compositor_command_sha256": {"$ref": "#/$defs/hash"},
        "compositor_config_sha256": {"$ref": "#/$defs/hash"},
        "previous_entry_sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "entry_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "execution_scope", "job_id", "source_set_sha256", "placement_plan_sha256", "graph_sha256", "temporal_map_sha256", "caption_track_sha256", "caption_cleanup_sha256", "layout_authority_sha256", "compositor_authority_sha256", "compositor_executable_sha256", "compositor_command_sha256", "compositor_config_sha256", "entries", "chain_sha256"],
      "properties": {
        "schema_version": {"const": "case-longform-caption-execution-ledger-v1"},
        "kind": {"const": "caption_execution_ledger"},
        "execution_scope": {"const": "CAPTION_DATA_GRAPH_ONLY"},
        "job_id": {"type": "string", "minLength": 1},
        "source_set_sha256": {"$ref": "#/$defs/hash"},
        "placement_plan_sha256": {"$ref": "#/$defs/hash"},
        "graph_sha256": {"$ref": "#/$defs/hash"},
        "temporal_map_sha256": {"$ref": "#/$defs/hash"},
        "caption_track_sha256": {"$ref": "#/$defs/hash"},
        "caption_cleanup_sha256": {"$ref": "#/$defs/hash"},
        "layout_authority_sha256": {"$ref": "#/$defs/hash"},
        "compositor_authority_sha256": {"$ref": "#/$defs/hash"},
        "compositor_executable_sha256": {"$ref": "#/$defs/hash"},
        "compositor_command_sha256": {"$ref": "#/$defs/hash"},
        "compositor_config_sha256": {"$ref": "#/$defs/hash"},
        "entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/entry"}},
        "chain_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "actor_id"],
      "properties": {"role": {"enum": ["CAPTION_VERIFIER", "GUARDIAN"]}, "actor_id": {"$ref": "#/$defs/id"}}
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "sequence", "ledger_sequence", "check", "caption_entry_sha256", "cue_id", "layout_id", "start_frame", "end_frame", "text_sha256", "font_sha256", "geometry"],
      "properties": {
        "task_id": {"$ref": "#/$defs/id"},
        "sequence": {"type": "integer", "minimum": 0},
        "ledger_sequence": {"type": "integer", "minimum": 0},
        "check": {"enum": ["TEXT_FIDELITY", "FRAME_TIMING", "LAYOUT_GEOMETRY", "SINGLE_LAYER", "BOUNDARY_CONTINUITY"]},
        "caption_entry_sha256": {"$ref": "#/$defs/hash"},
        "cue_id": {"$ref": "#/$defs/id"},
        "layout_id": {"$ref": "#/$defs/id"},
        "start_frame": {"type": "integer", "minimum": 0},
        "end_frame": {"type": "integer", "minimum": 0},
        "text_sha256": {"$ref": "#/$defs/hash"},
        "font_sha256": {"$ref": "#/$defs/hash"},
        "geometry": {"$ref": "#/$defs/geometry"}
      }
    },
    "reviewPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "kind", "plan_scope", "actor_id", "job_id", "source_set_sha256", "graph_sha256", "temporal_map_sha256", "caption_track_sha256", "caption_cleanup_sha256", "placement_plan_sha256", "execution_ledger_sha256", "layout_authority_sha256", "compositor_authority_sha256", "caption_verifier_authority_sha256", "reviewers", "checks", "tasks"],
      "properties": {
        "schema_version": {"const": "case-longform-caption-external-review-plan-v1"},
        "kind": {"const": "caption_external_review_plan"},
        "plan_scope": {"const": "PLANNING_ONLY_NO_OUTCOME"},
        "actor_id": {"$ref": "#/$defs/id"},
        "job_id": {"type": "string", "minLength": 1},
        "source_set_sha256": {"$ref": "#/$defs/hash"},
        "graph_sha256": {"$ref": "#/$defs/hash"},
        "temporal_map_sha256": {"$ref": "#/$defs/hash"},
        "caption_track_sha256": {"$ref": "#/$defs/hash"},
        "caption_cleanup_sha256": {"$ref": "#/$defs/hash"},
        "placement_plan_sha256": {"$ref": "#/$defs/hash"},
        "execution_ledger_sha256": {"$ref": "#/$defs/hash"},
        "layout_authority_sha256": {"$ref": "#/$defs/hash"},
        "compositor_authority_sha256": {"$ref": "#/$defs/hash"},
        "caption_verifier_authority_sha256": {"$ref": "#/$defs/hash"},
        "reviewers": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/reviewer"}},
        "checks": {"const": ["TEXT_FIDELITY", "FRAME_TIMING", "LAYOUT_GEOMETRY", "SINGLE_LAYER", "BOUNDARY_CONTINUITY"]},
        "tasks": {"type": "array", "minItems": 5, "items": {"$ref": "#/$defs/task"}}
      }
    },
    "authorityBundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract", "ledger", "reviewPlan"],
      "properties": {
        "contract": {"$ref": "#/$defs/contract"},
        "ledger": {"$ref": "#/$defs/ledger"},
        "reviewPlan": {"$ref": "#/$defs/reviewPlan"}
      }
    }
  }
}
