{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "general-video-v2",
  "title": "Frames ContentOS General Video SPEC-first workflow state",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "contractRevision", "projectId", "route", "artifactVisibility", "offline", "flow", "storyboard", "sourcePackRef", "sourcePackSha256", "specRef", "specId", "specSha256", "scriptMode", "scriptRef", "scriptSha256", "pieceScriptsRef", "pieceScriptsSha256", "assetManifestRef", "assetManifestSha256", "buildManifestRef", "reviewReceiptRef", "renderPolicy", "workProductState", "steps"],
  "properties": {
    "schemaVersion": {"const": "general-video-v2"},
    "contractRevision": {"const": 2},
    "projectId": {"type": "string", "minLength": 1},
    "route": {"const": "content-os-general-video"},
    "archetype": {"enum": ["general", "case-longform"]},
    "artifactVisibility": {"enum": ["versioned", "private-local"]},
    "offline": {"const": true},
    "flow": {"enum": ["automation", "companion"]},
    "storyboard": {"enum": ["yes", "no"]},
    "sourcePackRef": {"type": "string", "minLength": 1},
    "sourcePackSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceAnalysisRef": {"type": "string", "minLength": 1},
    "sourceAnalysisSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "compositionFitRef": {"type": "string", "minLength": 1},
    "compositionFitSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "storyboardRef": {"type": "string", "minLength": 1},
    "storyboardSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "specRef": {"type": "string", "minLength": 1},
    "specId": {"type": "string", "minLength": 3},
    "specSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scriptMode": {"enum": ["narration", "transcript", "action", "assembly_map", "data_chart"]},
    "scriptRef": {"type": "string", "minLength": 1},
    "scriptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "pieceScriptsRef": {"type": "string", "minLength": 1},
    "pieceScriptsSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "assetManifestRef": {"type": "string", "minLength": 1},
    "assetManifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "abTestRef": {"type": "string", "minLength": 1},
    "abTestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "buildManifestRef": {"type": "string", "minLength": 1},
    "buildManifestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewReceiptRef": {"type": "string", "minLength": 1},
    "reviewReceiptSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "renderReceiptRef": {"type": "string", "minLength": 1},
    "planRef": {"type": "string", "minLength": 1},
    "caseLongformAdapterRef": {"type": "string", "minLength": 1},
    "caseLongformAdapterSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "caseLongformPlanSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "scope_expanded": {"type": "boolean"},
    "workProductState": {"enum": ["ESPECIFICADO", "COMPILADO", "EVALUADO", "RENDERED_DRAFT", "HUMAN_APPROVED", "READY", "PUBLISHED", "BLOCKED"]},
    "renderPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["draftsAutomatic", "publicationAuthority", "cacheByHash"],
      "properties": {
        "draftsAutomatic": {"type": "boolean"},
        "publicationAuthority": {"const": false},
        "cacheByHash": {"const": true}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "state"],
        "properties": {
          "step": {"enum": ["setup", "ingest", "spec", "script", "plan", "resolve", "build", "assemble", "verify", "package", "finalize"]},
          "state": {"enum": ["pending", "in-progress", "gate-passed", "user-approved", "blocked"]}
        }
      }
    }
  },
  "allOf": [
    {"if": {"properties": {"storyboard": {"const": "yes"}}}, "then": {"required": ["storyboardRef", "storyboardSha256"]}},
    {
      "if": {"required": ["archetype"], "properties": {"archetype": {"const": "case-longform"}}},
      "then": {
        "required": ["caseLongformAdapterRef", "caseLongformAdapterSha256", "planRef"],
        "properties": {
          "workProductState": {"const": "BLOCKED"},
          "renderPolicy": {"properties": {"draftsAutomatic": {"const": false}}}
        }
      },
      "else": {"properties": {"renderPolicy": {"properties": {"draftsAutomatic": {"const": true}}}}}
    }
  ]
}
