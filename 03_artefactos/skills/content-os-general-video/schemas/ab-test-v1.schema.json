{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "ab-test-v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "state", "specId", "specSha256", "groups"],
  "properties": {
    "schemaVersion": {"const": "ab-test-v1"}, "state": {"const": "candidate"}, "specId": {"type": "string"}, "specSha256": {"$ref": "#/$defs/hash"},
    "groups": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "variantAxis", "pieceIds", "variants"], "properties": {
      "id": {"type": "string"}, "variantAxis": {"const": "visual"}, "pieceIds": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string"}},
      "variants": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object", "additionalProperties": false, "required": ["pieceId"], "properties": {"pieceId": {"type": "string"}}}}
    }}}
  }, "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
