{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "source-pack-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sourcePackId", "state", "sources"],
  "properties": {
    "schemaVersion": {"const": "source-pack-v1"},
    "sourcePackId": {"type": "string", "minLength": 3},
    "state": {"const": "FROZEN"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "ref", "sha256", "provenance", "rights", "authority", "limitations", "claimIds"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "ref": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "provenance": {"type": "string", "minLength": 1},
          "rights": {"enum": ["cleared", "owned", "licensed", "internal-evaluation"]},
          "authority": {"enum": ["first-party", "official", "observed", "user-assertion"]},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "claimIds": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
