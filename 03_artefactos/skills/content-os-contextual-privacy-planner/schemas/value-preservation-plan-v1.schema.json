{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metodologia.local/schemas/value-preservation-plan-v1.schema.json",
  "title": "ValuePreservationPlanV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "case_id", "participant_id", "source", "source_metadata", "privacy_policy_sha256", "value_guardian_actor_id", "zones", "status", "canonical_sha256"],
  "properties": {
    "schema_version": {"const": "value-preservation-plan-v1"},
    "plan_id": {"$ref": "#/$defs/id"}, "case_id": {"$ref": "#/$defs/id"}, "participant_id": {"$ref": "#/$defs/id"},
    "source": {"$ref": "#/$defs/ref"},
    "source_metadata": {"type": "object", "additionalProperties": false, "required": ["frame_width", "frame_height", "frame_count", "duration_ms", "has_audio"], "properties": {"frame_width": {"type": "integer", "minimum": 1}, "frame_height": {"type": "integer", "minimum": 1}, "frame_count": {"type": "integer", "minimum": 1}, "duration_ms": {"type": "integer", "minimum": 1}, "has_audio": {"type": "boolean"}}},
    "privacy_policy_sha256": {"$ref": "#/$defs/sha"},
    "value_guardian_actor_id": {"const": "RT-11-PRIVACY-VALUE-GUARDIAN"},
    "zones": {"type": "array", "minItems": 1, "maxItems": 128, "items": {"$ref": "#/$defs/zone"}},
    "status": {"const": "BLOCKED_PENDING_MINIMAL_REDACTION_PLAN"},
    "canonical_sha256": {"$ref": "#/$defs/sha"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "ref": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256", "bytes"], "properties": {"ref": {"type": "string", "pattern": "^(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*(?:^|/)\\.[^/])(?!.*\\\\)[a-z0-9](?:[a-z0-9._/-]*[a-z0-9])?$"}, "sha256": {"$ref": "#/$defs/sha"}, "bytes": {"type": "integer", "minimum": 1, "maximum": 9007199254740991}}},
    "span": {"type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": {"start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 0}}},
    "geometry": {"type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"], "properties": {"x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}},
    "zone": {"type": "object", "additionalProperties": false, "required": ["sequence", "zone_id", "kind", "frame_span", "geometry", "authorized_redaction_signal_ids"], "properties": {"sequence": {"type": "integer", "minimum": 0}, "zone_id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["STUDENT_DELIVERABLE", "OPERATION", "AUTHORIZED_FACE", "DRAWING", "RELEVANT_INTERFACE", "RESULT"]}, "frame_span": {"$ref": "#/$defs/span"}, "geometry": {"$ref": "#/$defs/geometry"}, "authorized_redaction_signal_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}}}
  }
}
