{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metodologia:frames:candidate-evidence-bank:v1",
  "title": "CandidateEvidenceBankV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidate_id", "evidence", "contradictions", "gaps"],
  "properties": {
    "candidate_id": {"type": "string", "pattern": "^CAND-[A-Z0-9-]+$"},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "claim", "context", "action_method", "result", "source_ref", "confidence", "allowed_channels", "constraints"],
        "properties": {
          "evidence_id": {"type": "string", "pattern": "^EVD-[A-Z0-9-]+$"},
          "claim": {"type": "string", "minLength": 1},
          "context": {"type": "string", "minLength": 1},
          "action_method": {"type": "string", "minLength": 1},
          "result": {"type": "string", "minLength": 1},
          "metric": {"type": ["object", "null"]},
          "source_ref": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"},
          "confidence": {"enum": ["verified", "user_confirmed", "inferred", "missing"]},
          "allowed_channels": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["cv", "letter", "interview", "form", "portfolio"]}},
          "constraints": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "contradictions": {"type": "array", "items": {"type": "object"}},
    "gaps": {"type": "array", "items": {"type": "object"}}
  }
}
