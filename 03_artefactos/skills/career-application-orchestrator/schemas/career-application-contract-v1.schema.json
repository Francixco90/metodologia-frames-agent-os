{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:metodologia:frames:career-application-contract:v1",
  "title": "CareerApplicationContractV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["intent", "brief", "state", "next_gate"],
  "properties": {
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request", "request_hash", "intent_class", "candidate_id", "selected_stage_path", "effect_class", "brief_ref", "next_gate", "decision"],
      "properties": {
        "schema_version": {"const": "career-intent-v1"},
        "request": {"type": "string", "minLength": 1},
        "request_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "intent_class": {"enum": ["general_cv", "targeted_cv", "cover_letter", "job_search", "full_application", "follow_up", "intervention"]},
        "candidate_id": {"type": ["string", "null"], "pattern": "^CAND-[A-Z0-9-]+$"},
        "application_id": {"type": ["string", "null"], "pattern": "^APP-[A-Z0-9-]+$"},
        "language": {"enum": ["es", "en", "pt", "unknown"]},
        "selected_stage_path": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"pattern": "^C0[0-9]$"}},
        "blocking_questions": {"type": "array", "maxItems": 3, "items": {"type": "string", "minLength": 1}},
        "effect_class": {"enum": ["read_only", "local_reversible", "external_reversible", "irreversible"]},
        "brief_ref": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+$"},
        "next_gate": {"type": "string", "pattern": "^CR_[A-Z0-9_]+$"},
        "decision": {"enum": ["ROUTED", "NEEDS_INPUT", "BLOCKED"]}
      }
    },
    "brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brief_id", "brief_type", "canonical_markdown_ref", "content_sha256"],
      "properties": {
        "brief_id": {"type": "string", "pattern": "^CBRIEF-[A-Z0-9-]+$"},
        "brief_type": {"enum": ["candidate-foundation", "job-search", "application", "intervention"]},
        "canonical_markdown_ref": {"type": "string", "pattern": "^(?!/)(?!.*\\.\\.).+\\.md$"},
        "html_ref": {"type": ["string", "null"], "pattern": "^(?!/)(?!.*\\.\\.).+\\.html$"},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "state": {"enum": ["DISCOVERED", "VALIDATED", "SHORTLISTED", "PACKAGED", "DRAFTED", "SUBMITTED", "BLOCKED", "CLOSED", "REJECTED", "INTERVIEW", "OFFER"]},
    "next_gate": {"type": "string", "minLength": 1}
  }
}
