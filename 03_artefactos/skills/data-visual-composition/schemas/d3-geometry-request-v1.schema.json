{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metodologia.local/schemas/d3-geometry-request-v1.schema.json",
  "title": "D3VisualRequestV1",
  "oneOf": [{"$ref": "#/$defs/categoricalMatrix"}, {"$ref": "#/$defs/quantitativeSeries"}, {"$ref": "#/$defs/hierarchyTree"}, {"$ref": "#/$defs/interpolation"}],
  "$defs": {
    "portableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{1,127}$"},
    "nonEmptyText": {"type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S"},
    "margins": {"type": "object", "additionalProperties": false, "required": ["top", "right", "bottom", "left"], "properties": {"top": {"type": "number", "minimum": 0}, "right": {"type": "number", "minimum": 0}, "bottom": {"type": "number", "minimum": 0}, "left": {"type": "number", "minimum": 0}}},
    "idList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/portableId"}},
    "axisEntry": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"$ref": "#/$defs/portableId"}, "label": {"$ref": "#/$defs/nonEmptyText"}}},
    "matrixCell": {"type": "object", "additionalProperties": false, "required": ["rowId", "columnId", "state", "label", "marker"], "properties": {"rowId": {"$ref": "#/$defs/portableId"}, "columnId": {"$ref": "#/$defs/portableId"}, "state": {"$ref": "#/$defs/nonEmptyText"}, "label": {"$ref": "#/$defs/nonEmptyText"}, "marker": {"$ref": "#/$defs/nonEmptyText"}}},
    "categoricalMatrix": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "requestId", "kind", "width", "height", "margins", "equivalentMessage", "nonColorCue", "fallback", "sourceAtomIds", "rows", "columns", "rowOrder", "columnOrder", "cells"], "properties": {"schemaVersion": {"const": "d3-geometry-request-v1"}, "requestId": {"$ref": "#/$defs/portableId"}, "kind": {"const": "categorical_matrix"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "margins": {"$ref": "#/$defs/margins"}, "equivalentMessage": {"$ref": "#/$defs/nonEmptyText"}, "nonColorCue": {"$ref": "#/$defs/nonEmptyText"}, "fallback": {"const": "semantic_table"}, "sourceAtomIds": {"$ref": "#/$defs/idList"}, "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/axisEntry"}}, "columns": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/axisEntry"}}, "rowOrder": {"$ref": "#/$defs/idList"}, "columnOrder": {"$ref": "#/$defs/idList"}, "cells": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/matrixCell"}}}},
    "datasetRef": {"type": "object", "additionalProperties": false, "required": ["ref", "sha256"], "properties": {"ref": {"$ref": "#/$defs/nonEmptyText"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "metric": {"type": "object", "additionalProperties": false, "required": ["unit", "denominator", "period", "method"], "properties": {"unit": {"$ref": "#/$defs/nonEmptyText"}, "denominator": {"$ref": "#/$defs/nonEmptyText"}, "period": {"$ref": "#/$defs/nonEmptyText"}, "method": {"$ref": "#/$defs/nonEmptyText"}}},
    "seriesItem": {"type": "object", "additionalProperties": false, "required": ["id", "label", "value"], "properties": {"id": {"$ref": "#/$defs/portableId"}, "label": {"$ref": "#/$defs/nonEmptyText"}, "value": {"type": "number"}}},
    "quantitativeSeries": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "requestId", "kind", "width", "height", "margins", "equivalentMessage", "nonColorCue", "fallback", "claimId", "datasetRef", "metric", "items", "order"], "properties": {"schemaVersion": {"const": "d3-geometry-request-v1"}, "requestId": {"$ref": "#/$defs/portableId"}, "kind": {"const": "quantitative_series"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "margins": {"$ref": "#/$defs/margins"}, "equivalentMessage": {"$ref": "#/$defs/nonEmptyText"}, "nonColorCue": {"$ref": "#/$defs/nonEmptyText"}, "fallback": {"const": "semantic_table"}, "claimId": {"$ref": "#/$defs/portableId"}, "datasetRef": {"$ref": "#/$defs/datasetRef"}, "metric": {"$ref": "#/$defs/metric"}, "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/seriesItem"}}, "order": {"$ref": "#/$defs/idList"}}},
    "hierarchyNode": {"type": "object", "additionalProperties": false, "required": ["id", "label", "parentId", "order"], "properties": {"id": {"$ref": "#/$defs/portableId"}, "label": {"$ref": "#/$defs/nonEmptyText"}, "parentId": {"anyOf": [{"$ref": "#/$defs/portableId"}, {"type": "null"}]}, "order": {"type": "integer", "minimum": 0}}},
    "hierarchyTree": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "requestId", "width", "height", "margins", "equivalentMessage", "nonColorCue", "sourceAtomIds", "fallback", "nodes"], "properties": {"schemaVersion": {"const": "d3-hierarchy-request-v1"}, "requestId": {"$ref": "#/$defs/portableId"}, "width": {"type": "number", "exclusiveMinimum": 0}, "height": {"type": "number", "exclusiveMinimum": 0}, "margins": {"$ref": "#/$defs/margins"}, "equivalentMessage": {"$ref": "#/$defs/nonEmptyText"}, "nonColorCue": {"$ref": "#/$defs/nonEmptyText"}, "sourceAtomIds": {"$ref": "#/$defs/idList"}, "fallback": {"const": "adjacency_list"}, "nodes": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/hierarchyNode"}}}},
    "geometryChannel": {"type": "object", "additionalProperties": false, "required": ["id", "label", "start", "end", "geometryUnit", "semanticRole"], "properties": {"id": {"$ref": "#/$defs/portableId"}, "label": {"$ref": "#/$defs/nonEmptyText"}, "start": {"type": "number"}, "end": {"type": "number"}, "geometryUnit": {"enum": ["degrees", "px", "ratio"]}, "semanticRole": {"const": "geometry_only"}}},
    "interpolation": {"type": "object", "additionalProperties": false, "required": ["schemaVersion", "requestId", "progress", "equivalentMessage", "nonColorCue", "order", "channels"], "properties": {"schemaVersion": {"const": "d3-interpolation-request-v1"}, "requestId": {"$ref": "#/$defs/portableId"}, "progress": {"type": "number", "minimum": 0, "maximum": 1}, "equivalentMessage": {"$ref": "#/$defs/nonEmptyText"}, "nonColorCue": {"$ref": "#/$defs/nonEmptyText"}, "order": {"$ref": "#/$defs/idList"}, "channels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/geometryChannel"}}}}
  }
}
