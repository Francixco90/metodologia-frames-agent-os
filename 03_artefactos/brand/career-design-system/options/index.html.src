<!doctype html>
<html lang="es" data-theme="navy">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow"><meta name="color-scheme" content="dark light">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline' data:; script-src 'unsafe-inline'; font-src data:; frame-src 'self'">
  <title>Comparador · alternativas CV MetodologIA</title>
  <link rel="stylesheet" href="{{CAREER_PALETTE_DATA_URL}}">
  <style>
    @font-face{font-family:Poppins;src:url('{{POPPINS_BOLD_DATA_URL}}');font-weight:700}@font-face{font-family:Montserrat;src:url('{{MONTSERRAT_DATA_URL}}');font-weight:100 900}
    /* SHARED_PRIMITIVES_START */:root{--bg:var(--career-option-canvas);--surface:var(--career-option-surface);--surface-2:var(--career-option-surface-raised);--ink:var(--career-option-text);--soft:var(--career-option-text-muted);--gold:var(--career-option-accent);--gold-ink:var(--career-option-accent-text);--line:var(--career-option-line);--focus:var(--career-option-focus);--shadow:var(--career-option-shadow);--backdrop:var(--career-option-backdrop);--r:18px;--max:1240px;color-scheme:dark}html[data-theme="light"]{color-scheme:light}/* SHARED_PRIMITIVES_END */
    *{box-sizing:border-box}body{margin:0;background:var(--bg);color:var(--ink);font:1rem/1.55 'Trebuchet MS',Arial,sans-serif}.wrap{max-width:1440px;margin:auto;padding:clamp(20px,4vw,56px)}header{display:grid;grid-template-columns:1fr auto;gap:2rem;align-items:end;padding-bottom:2rem;border-bottom:1px solid var(--line)}.eyebrow,.status,.controls,.option-label{font-family:Montserrat,sans-serif;font-weight:700;letter-spacing:.11em;text-transform:uppercase}.eyebrow,.status{color:var(--gold);font-size:.68rem}h1{max-width:16ch;margin:.7rem 0 0;font:700 clamp(2.4rem,6vw,5.5rem)/.94 Poppins,sans-serif;letter-spacing:-.055em}.intro{max-width:56ch;color:var(--soft)}
    .controls{display:flex;flex-wrap:wrap;gap:.55rem;margin:2rem 0;font-size:.68rem}.controls button{min-height:44px;padding:.65rem 1rem;border:1px solid var(--line);border-radius:999px;background:var(--surface);color:var(--ink);font:inherit;cursor:pointer}.controls button[aria-pressed="true"]{border-color:var(--gold);background:var(--gold);color:var(--gold-ink)}button:focus-visible{outline:3px solid var(--focus);outline-offset:2px}.matrix{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));margin-bottom:2rem;border:1px solid var(--line)}.matrix article{padding:1.2rem}.matrix article+article{border-left:1px solid var(--line)}.matrix h2{margin:.5rem 0;font:700 1.3rem Poppins,sans-serif}.matrix p{margin:0;color:var(--soft);font-size:.86rem}.matrix ul{margin:.8rem 0 0;padding-left:1.1rem;color:var(--soft);font-size:.78rem}
    .previews{display:grid;gap:2rem}.preview{padding:1rem;border:1px solid var(--line);background:var(--surface)}.preview-head{display:flex;justify-content:space-between;gap:1rem;align-items:center;margin-bottom:.8rem}.option-label{color:var(--gold);font-size:.67rem}.preview a{display:inline-flex;align-items:center;min-width:44px;min-height:44px;color:var(--ink);font-size:.78rem}.viewport{width:100%;margin:auto;transition:width .25s ease}.viewport[data-mode="mobile"]{width:390px;max-width:100%}iframe{display:block;width:100%;height:800px;border:1px solid var(--line);background:var(--bg)}footer{padding-top:2rem;color:var(--soft);font-size:.78rem}
    @media(max-width:760px){header{grid-template-columns:1fr}.matrix{grid-template-columns:1fr}.matrix article+article{border-left:0;border-top:1px solid var(--line)}iframe{height:680px}}@media(prefers-reduced-motion:reduce){*{transition:none!important}}@media print{.controls{display:none}.wrap{max-width:none}.preview{break-before:page}.viewport{width:100%!important}iframe{height:900px}}
  </style>
</head>
<body><main class="wrap"><header><div><span class="eyebrow">MetodologIA · Career Design Options</span><h1>Dos formas de hacer visible el mismo criterio.</h1></div><div><p class="status">DESIGN_OPTIONS_READY</p><p class="intro">Comparación sintética. Ninguna alternativa está seleccionada ni aprobada.</p></div></header>
  <div class="controls" role="group" aria-label="Tamaño de los previews"><button type="button" data-mode="desktop" aria-pressed="true">Escritorio</button><button type="button" data-mode="mobile" aria-pressed="false">Móvil · 390 px</button></div>
  <section class="matrix" aria-label="Diferencias entre alternativas"><article><span class="option-label">A · Blueprint Executive</span><h2>Sistema visible</h2><p>Alta densidad, retícula técnica y lectura por capas.</p><ul><li>Mejor para alcance y gobierno.</li><li>Rail reducido en desktop.</li><li>Riesgo: decoración excesiva.</li></ul></article><article><span class="option-label">B · Neo-Swiss Editorial</span><h2>Criterio visible</h2><p>Asimetría, aire y narrativa dirigida por decisiones.</p><ul><li>Mejor para voz y recordación.</li><li>Flujo editorial continuo.</li><li>Riesgo: menor densidad simultánea.</li></ul></article></section>
  <section class="previews" aria-label="Previews"><article class="preview"><div class="preview-head"><span class="option-label">A · Blueprint Executive</span><a href="blueprint-executive/index.html">Abrir sin marco</a></div><div class="viewport" data-mode="desktop"><iframe src="blueprint-executive/index.html" title="Preview Blueprint Executive"></iframe></div></article><article class="preview"><div class="preview-head"><span class="option-label">B · Neo-Swiss Editorial</span><a href="neo-swiss-editorial/index.html">Abrir sin marco</a></div><div class="viewport" data-mode="desktop"><iframe src="neo-swiss-editorial/index.html" title="Preview Neo-Swiss Editorial"></iframe></div></article></section>
  <footer>Preview público sintético · Sin PII · Sin selección · Sin publicación</footer></main>
  <script>(()=>{const buttons=[...document.querySelectorAll('[data-mode]')].filter(x=>x.tagName==='BUTTON'),frames=[...document.querySelectorAll('.viewport')];buttons.forEach(button=>button.addEventListener('click',()=>{buttons.forEach(x=>x.setAttribute('aria-pressed',String(x===button)));frames.forEach(x=>x.dataset.mode=button.dataset.mode)}))})();</script>
</body>
</html>
