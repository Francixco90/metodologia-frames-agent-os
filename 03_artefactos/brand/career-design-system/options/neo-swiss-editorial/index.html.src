<!doctype html>
<html lang="es" data-theme="navy">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow"><meta name="color-scheme" content="dark light">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline' data:; script-src 'unsafe-inline'; font-src data:; img-src data:">
  <title>Neo-Swiss Editorial · alternativa sintética</title>
  <link rel="stylesheet" href="{{CAREER_PALETTE_DATA_URL}}">
  <style>
    @font-face{font-family:Poppins;src:url('{{POPPINS_BOLD_DATA_URL}}');font-weight:700}@font-face{font-family:Montserrat;src:url('{{MONTSERRAT_DATA_URL}}');font-weight:100 900}
    /* SHARED_PRIMITIVES_START */:root{--bg:var(--career-option-canvas);--surface:var(--career-option-surface);--surface-2:var(--career-option-surface-raised);--ink:var(--career-option-text);--soft:var(--career-option-text-muted);--gold:var(--career-option-accent);--gold-ink:var(--career-option-accent-text);--line:var(--career-option-line);--focus:var(--career-option-focus);--shadow:var(--career-option-shadow);--backdrop:var(--career-option-backdrop);--r:18px;--max:1240px;color-scheme:dark}html[data-theme="light"]{color-scheme:light}/* SHARED_PRIMITIVES_END */
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font:1rem/1.62 'Trebuchet MS',Arial,sans-serif}a{color:inherit}.wrap{max-width:var(--max);margin:auto;padding-inline:clamp(20px,5vw,68px)}.skip{position:fixed;top:-5rem;left:1rem;z-index:30;display:inline-flex;min-height:44px;align-items:center;padding:.8rem 1rem;background:var(--gold);color:var(--gold-ink);font:700 .76rem Montserrat,sans-serif}.skip:focus{top:1rem}
    .top{min-height:84px;display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:2rem;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:.65rem;font:700 .76rem Montserrat,sans-serif;letter-spacing:.1em;text-transform:uppercase}.brand svg{width:30px;color:var(--gold)}nav{justify-self:center;display:flex;gap:.7rem;font:700 .69rem Montserrat,sans-serif;letter-spacing:.08em;text-transform:uppercase}nav a{display:inline-flex;min-height:44px;align-items:center;padding-inline:.5rem;text-decoration:none}nav a:hover{text-decoration:underline;text-decoration-color:var(--gold);text-underline-offset:.38rem}.tools{display:flex;align-items:center;gap:.65rem}.demo{color:var(--gold);font:700 .62rem Montserrat,sans-serif;letter-spacing:.1em;text-transform:uppercase}
    button{font:inherit}.theme,.close{display:grid;place-items:center;width:44px;height:44px;border:1px solid var(--line);border-radius:50%;background:var(--surface);color:var(--ink);cursor:pointer}html:not(.js) .theme{display:none}.theme svg,.close svg{width:20px}.theme:hover,.theme:focus-visible,.close:hover,.close:focus-visible,.evidence-button:hover,.evidence-button:focus-visible{outline:3px solid var(--focus);outline-offset:2px;border-color:var(--gold)}
    .hero{min-height:min(780px,calc(100vh - 84px));display:grid;grid-template-columns:minmax(0,1.3fr) minmax(280px,.7fr);gap:clamp(2rem,7vw,7rem);align-items:center;padding-block:clamp(4rem,9vw,8rem)}.kicker,.label,.chapter-no,.availability strong{font-family:Montserrat,sans-serif;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.kicker{margin:0 0 1.2rem;color:var(--gold);font-size:.7rem}.hero h1{max-width:11ch;margin:0;font:700 clamp(3.3rem,8vw,7.8rem)/.88 Poppins,sans-serif;letter-spacing:-.07em}.hero-copy>p:last-child{max-width:56ch;margin:1.8rem 0 0;color:var(--soft);font-size:clamp(1rem,1.8vw,1.25rem)}
    .availability{align-self:end;padding:1.4rem;border-top:4px solid var(--gold);background:var(--surface);box-shadow:var(--shadow)}.availability strong{display:block;color:var(--gold);font-size:.68rem}.availability h2{margin:.8rem 0 .5rem;font:700 clamp(1.4rem,3vw,2.1rem)/1.05 Poppins,sans-serif}.availability p{margin:0;color:var(--soft);font-size:.88rem}.availability ul{display:flex;flex-wrap:wrap;gap:.45rem;margin:1rem 0 0;padding:0;list-style:none}.availability li{padding:.35rem .55rem;border:1px solid var(--line);font-size:.7rem}
    .proof{border-block:1px solid var(--line)}.proof-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr))}.proof article{min-width:0;min-height:220px;padding:clamp(1.3rem,3vw,2.4rem);display:flex;flex-direction:column;justify-content:space-between}.proof article+article{border-left:1px solid var(--line)}.proof strong{display:block;max-width:11ch;overflow-wrap:normal;word-break:normal;hyphens:none;color:var(--gold);font:700 clamp(1.8rem,4vw,3.8rem)/.94 Poppins,sans-serif;letter-spacing:-.05em}.proof p{max-width:30ch;margin:1rem 0 0;color:var(--soft)}.proof small{color:var(--soft)}
    .section{padding-block:clamp(4rem,9vw,8rem)}.section-title{display:grid;grid-template-columns:1fr 2fr;gap:2rem;align-items:end;margin-bottom:clamp(2rem,5vw,4rem)}.label{color:var(--gold);font-size:.68rem}.section-title h2{max-width:16ch;margin:0;font:700 clamp(2.3rem,5.5vw,5rem)/.95 Poppins,sans-serif;letter-spacing:-.05em}.chapters{border-top:1px solid var(--line)}.chapter{display:grid;grid-template-columns:120px minmax(0,.8fr) minmax(260px,1.2fr);gap:2rem;padding:2rem 0;border-bottom:1px solid var(--line)}.chapter-no{color:var(--gold);font-size:.7rem}.chapter h3{margin:0;font:700 1.35rem/1.2 Poppins,sans-serif}.chapter p{max-width:62ch;margin:0;color:var(--soft)}
    .capabilities{display:grid;grid-template-columns:repeat(2,1fr);gap:0;border-top:1px solid var(--line)}.capabilities details{padding:1.4rem 1rem;border-bottom:1px solid var(--line)}.capabilities details:nth-child(odd){border-right:1px solid var(--line)}summary{min-height:44px;display:flex;align-items:center;cursor:pointer;font:700 clamp(1rem,2vw,1.25rem) Poppins,sans-serif}summary::marker{color:var(--gold)}details p{max-width:56ch;margin:.8rem 0 0;color:var(--soft);font-size:.88rem}.evidence-source{margin-top:1rem}.js .evidence-source{display:none}.evidence-button{display:none;min-height:44px;margin-top:1rem;padding:.7rem 1rem;border:1px solid var(--gold);border-radius:999px;background:var(--gold);color:var(--gold-ink);font:700 .72rem Montserrat,sans-serif;cursor:pointer}.js .evidence-button{display:inline-flex;align-items:center;gap:.45rem}
    dialog{width:min(680px,calc(100% - 2rem));max-height:84vh;padding:0;border:1px solid var(--line);background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}dialog::backdrop{background:var(--backdrop)}.dialog-inner{padding:clamp(1.4rem,5vw,2.8rem)}.close{position:sticky;float:right;top:.75rem;z-index:2}.dialog-inner h2{max-width:16ch;margin:.5rem 3.5rem 1rem 0;font:700 clamp(1.8rem,5vw,3rem)/1 Poppins,sans-serif}.dialog-inner p,.dialog-inner li{color:var(--soft)}footer{padding-block:2.2rem;border-top:1px solid var(--line);color:var(--soft);font-size:.78rem}
    @media(max-width:900px){nav{display:none}.hero{grid-template-columns:1fr;min-height:auto}.availability{align-self:auto;max-width:520px}.section-title{grid-template-columns:1fr}.chapter{grid-template-columns:80px 1fr}.chapter p{grid-column:2}}@media(max-width:620px){.top{grid-template-columns:1fr auto}.demo{display:none}.hero h1{font-size:clamp(3rem,16vw,5rem)}.proof-grid{grid-template-columns:1fr}.proof article{min-height:180px}.proof article+article{border-left:0;border-top:1px solid var(--line)}.chapter{grid-template-columns:1fr;gap:.6rem}.chapter p{grid-column:auto}.capabilities{grid-template-columns:1fr}.capabilities details:nth-child(odd){border-right:0}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}@media print{html[data-theme]{--bg:var(--career-option-canvas);--surface:var(--career-option-surface);--surface-2:var(--career-option-surface-raised);--ink:var(--career-option-text);--soft:var(--career-option-text-muted);--gold:var(--career-option-accent);--line:var(--career-option-line);color-scheme:light}.theme,.demo,nav,.js .evidence-button{display:none!important}.hero{min-height:auto;padding-block:2rem}.section{padding-block:2rem}.chapter,.capabilities details,.proof article{break-inside:avoid}}
  </style>
  <script>document.documentElement.classList.add('js');try{if(localStorage.getItem('mdg_cv_theme')==='light')document.documentElement.dataset.theme='light'}catch(e){}</script>
</head>
<body>
<a class="skip" href="#contenido">Saltar al contenido</a>
<header class="wrap top"><div class="brand"><svg viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M3 26V6h5l8 11 8-11h5v20h-6V15l-7 9-7-9v11z"/></svg><span>MetodologIA · Career</span></div><nav aria-label="Principal"><a href="#experiencia">Experiencia</a><a href="#resultados">Resultados</a><a href="#capacidades">Capacidades</a></nav><div class="tools"><span class="demo">Demo sintética</span><button class="theme" type="button" aria-label="Activar tema claro" aria-pressed="false" data-label-light="Activar tema claro" data-label-navy="Activar tema azul"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/></svg></button></div></header>
<main id="contenido">
  <section class="wrap hero" aria-labelledby="hero-title"><div class="hero-copy"><p class="kicker">Dirección · Producto · Transformación · IA</p><h1 id="hero-title">Hacer que lo complejo avance.</h1><p>Convierto retos en decisiones y decisiones en capacidades que producen valor temprano, medible y acumulativo.</p></div><aside class="availability"><strong>Escenario sintético</strong><h2>Liderazgo para una transformación que necesita foco.</h2><p>Una voz ejecutiva, evidencia trazable y profundidad solo cuando aporta.</p><ul><li>Estrategia</li><li>Producto</li><li>IA aplicada</li></ul></aside></section>
  <section id="resultados" class="proof" aria-label="Resultados ilustrativos"><div class="wrap proof-grid"><article><strong>Foco antes que volumen.</strong><div><p>Tres frentes priorizados bajo una sola tesis de valor.</p><small>Ejemplo, no claim</small></div></article><article><strong>Decidir para aprender.</strong><div><p>Un piloto con criterios explícitos de continuidad.</p><small>Escenario sintético</small></div></article><article><strong>Capacidad que permanece.</strong><div><p>Gobierno y prácticas transferidas al equipo.</p><small>Modelo ilustrativo</small></div></article></div></section>
  <section id="experiencia" class="wrap section"><div class="section-title"><span class="label">01 · Experiencia</span><h2>Capítulos definidos por decisiones.</h2></div><div class="chapters"><article class="chapter"><span class="chapter-no">01 / Actual</span><h3>Dirección de transformación</h3><div><p>Convirtió una cartera dispersa en una secuencia gobernada de decisiones, experimentos y aprendizaje operativo.</p><button class="evidence-button" type="button" data-open="evidence"><svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2"/></svg>Ver patrón de evidencia</button><details class="evidence-source"><summary>Ver patrón de evidencia</summary><p>Ejemplo sintético: reto delimitado, atribución explícita, fuente autorizada y límite documentado.</p></details></div></article><article class="chapter"><span class="chapter-no">02 / Anterior</span><h3>Liderazgo de producto</h3><p>Alineó discovery, roadmap y operación alrededor de una señal compartida de adopción.</p></article><article class="chapter"><span class="chapter-no">03 / Previa</span><h3>Unidad de negocio</h3><p>Integró dirección comercial, capacidad del equipo y desempeño operativo en una cadencia común.</p></article></div></section>
  <section id="capacidades" class="wrap section"><div class="section-title"><span class="label">02 · Capacidades</span><h2>Un índice de intervención.</h2></div><div class="capabilities"><details><summary>Estrategia operable</summary><p>Prioridad, secuencia, responsables y señales de avance.</p></details><details><summary>Transformación con IA</summary><p>Disrupción viable, adopción y riesgo desde el diseño.</p></details><details><summary>Dirección de producto</summary><p>Discovery y delivery conectados con una decisión de negocio.</p></details><details><summary>Diseño organizacional</summary><p>Estructura y capacidades alineadas con el modelo operativo.</p></details><details><summary>Gobierno de programas</summary><p>Dependencias, decisiones y evidencia ejecutiva sin burocracia ornamental.</p></details><details><summary>Liderazgo de unidades</summary><p>Responsabilidad integral sobre dirección, operación y resultados.</p></details></div></section>
</main>
<dialog id="evidence" aria-labelledby="evidence-title"><div class="dialog-inner"><button class="close" type="button" aria-label="Cerrar evidencia"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2"/></svg></button><p class="kicker">Patrón de evidencia</p><h2 id="evidence-title">La profundidad debe mejorar la decisión.</h2><p>Una experiencia real debe separar con precisión:</p><ul><li>El reto y el alcance verificable.</li><li>La decisión y la contribución del candidato.</li><li>El resultado respaldado por una fuente.</li><li>Lo que permanece desconocido o fuera de atribución.</li></ul></div></dialog>
<footer class="wrap">Alternativa B · Neo-Swiss Editorial · Preview sintético · DESIGN_OPTIONS_READY</footer>
<script>(()=>{const root=document.documentElement,t=document.querySelector('.theme'),d=document.querySelector('#evidence'),open=document.querySelector('[data-open="evidence"]'),close=d.querySelector('.close');let lastFocus;const sync=()=>{const light=root.dataset.theme==='light';t.setAttribute('aria-pressed',String(light));t.setAttribute('aria-label',light?t.dataset.labelNavy:t.dataset.labelLight)};sync();t.addEventListener('click',()=>{root.dataset.theme=root.dataset.theme==='light'?'navy':'light';try{localStorage.setItem('mdg_cv_theme',root.dataset.theme)}catch(e){}sync()});open.addEventListener('click',()=>{lastFocus=open;d.showModal();close.focus()});close.addEventListener('click',()=>d.close());d.addEventListener('click',e=>{if(e.target===d)d.close()});d.addEventListener('keydown',e=>{if(e.key==='Tab'){e.preventDefault();close.focus()}});d.addEventListener('close',()=>lastFocus?.focus())})();</script>
</body>
</html>
