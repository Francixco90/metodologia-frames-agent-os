<!doctype html>
<html lang="es" data-theme="navy">
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
  <meta name="robots" content="noindex,nofollow"><meta name="color-scheme" content="dark light">
  <meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'unsafe-inline' data:; script-src 'unsafe-inline'; font-src data:; img-src data:">
  <title>Blueprint Executive · alternativa sintética</title>
  <link rel="stylesheet" href="{{CAREER_PALETTE_DATA_URL}}">
  <style>
    @font-face{font-family:Poppins;src:url('{{POPPINS_BOLD_DATA_URL}}');font-weight:700}@font-face{font-family:Montserrat;src:url('{{MONTSERRAT_DATA_URL}}');font-weight:100 900}
    /* SHARED_PRIMITIVES_START */:root{--bg:var(--career-option-canvas);--surface:var(--career-option-surface);--surface-2:var(--career-option-surface-raised);--ink:var(--career-option-text);--soft:var(--career-option-text-muted);--gold:var(--career-option-accent);--gold-ink:var(--career-option-accent-text);--line:var(--career-option-line);--focus:var(--career-option-focus);--shadow:var(--career-option-shadow);--backdrop:var(--career-option-backdrop);--r:18px;--max:1240px;color-scheme:dark}html[data-theme="light"]{color-scheme:light}/* SHARED_PRIMITIVES_END */
    *{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--bg);color:var(--ink);font:1rem/1.58 'Trebuchet MS',Arial,sans-serif}body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.13;background-size:48px 48px;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px)}
    a{color:inherit}.skip{position:fixed;z-index:20;left:1rem;top:-5rem;display:inline-flex;min-height:44px;align-items:center;padding:.75rem 1rem;background:var(--gold);color:var(--gold-ink);font:700 .78rem Poppins,sans-serif}.skip:focus{top:1rem}.shell{position:relative;max-width:var(--max);margin:auto;padding:0 28px}.top{min-height:76px;display:flex;align-items:center;justify-content:space-between;gap:1rem;border-bottom:1px solid var(--line)}
    .brand,.eyebrow,.nav,.tag,.meta,.demo{font-family:Montserrat,sans-serif;font-weight:700;letter-spacing:.11em;text-transform:uppercase}.brand{display:flex;align-items:center;gap:.7rem;font-size:.78rem}.brand-mark{width:28px;height:28px;color:var(--gold)}.nav{display:flex;gap:.5rem;font-size:.7rem}.nav a{display:inline-flex;min-height:44px;align-items:center;padding-inline:.35rem;text-decoration:none}.nav a:hover{text-decoration:underline;text-decoration-color:var(--gold);text-underline-offset:.35rem}.actions{display:flex;align-items:center;gap:.7rem}.demo{font-size:.62rem;color:var(--gold)}
    button{font:inherit}.theme,.evidence-button,.close{min-width:44px;min-height:44px;border:1px solid var(--line);background:var(--surface);color:var(--ink);cursor:pointer}.theme,.close{display:grid;place-items:center;border-radius:50%}html:not(.js) .theme{display:none}.theme:hover,.theme:focus-visible,.close:hover,.close:focus-visible,.evidence-button:hover,.evidence-button:focus-visible{outline:3px solid var(--focus);outline-offset:2px;border-color:var(--gold)}.theme svg,.close svg{width:20px;height:20px}
    main{padding:clamp(3rem,7vw,6.5rem) 0}.hero{display:grid;grid-template-columns:minmax(0,1fr) minmax(220px,320px);gap:clamp(2rem,6vw,6rem);align-items:end}.eyebrow{margin:0 0 1rem;color:var(--gold);font-size:.72rem}.hero h1{max-width:13ch;margin:0;font:700 clamp(2.8rem,7vw,6.2rem)/.94 Poppins,sans-serif;letter-spacing:-.055em}.lead{max-width:62ch;margin:1.5rem 0 0;color:var(--soft);font-size:clamp(1.05rem,2vw,1.3rem)}
    .rail{padding:1.2rem;border:1px solid var(--line);border-radius:var(--r);background:color-mix(in srgb,var(--surface) 86%,transparent);box-shadow:var(--shadow)}.rail svg{width:44px;color:var(--gold)}.rail h2{margin:.8rem 0 .4rem;font:700 1rem Poppins,sans-serif}.rail p{margin:0;color:var(--soft);font-size:.88rem}.rail ol{margin:1rem 0 0;padding-left:1.2rem;color:var(--soft);font-size:.78rem}
    .proof{display:grid;grid-template-columns:repeat(3,1fr);margin:clamp(3rem,7vw,6rem) 0;border-block:1px solid var(--line)}.proof article{padding:1.4rem}.proof article+article{border-left:1px solid var(--line)}.proof strong{display:block;color:var(--gold);font:700 clamp(1.3rem,3vw,2rem) Poppins,sans-serif}.proof span{display:block;color:var(--soft);font-size:.78rem}.proof small{display:block;margin-top:.35rem;color:var(--soft)}
    .section{padding:clamp(2rem,5vw,4.5rem) 0}.section-head{display:grid;grid-template-columns:180px 1fr;gap:1rem;margin-bottom:1.6rem}.section-head span{color:var(--gold);font:700 .68rem Montserrat,sans-serif;letter-spacing:.12em}.section-head h2{max-width:18ch;margin:0;font:700 clamp(2rem,5vw,4rem)/1 Poppins,sans-serif;letter-spacing:-.04em}.timeline{display:grid;gap:1rem}.role{display:grid;grid-template-columns:180px 1fr;gap:1rem;padding:1.4rem;border:1px solid var(--line);border-radius:var(--r);background:var(--surface)}.meta{color:var(--gold);font-size:.66rem}.role h3{margin:0 0 .45rem;font:700 1.25rem Poppins,sans-serif}.role p{max-width:70ch;margin:0;color:var(--soft)}
    .capabilities{display:grid;grid-template-columns:repeat(3,1fr);gap:1rem}.capabilities details{padding:1.2rem;border:1px solid var(--line);border-radius:var(--r);background:var(--surface)}summary{min-height:44px;display:flex;align-items:center;cursor:pointer;font:700 1rem Poppins,sans-serif}summary::marker{color:var(--gold)}details p{margin:.75rem 0 0;color:var(--soft);font-size:.86rem}.evidence-source{margin-top:1rem}.js .evidence-source{display:none}.evidence-button{display:none;margin-top:1rem;padding:.65rem 1rem;border-radius:999px;color:var(--ink);font:700 .75rem Montserrat,sans-serif}.js .evidence-button{display:inline-flex;align-items:center;gap:.5rem}
    dialog{width:min(650px,calc(100% - 2rem));max-height:84vh;padding:0;border:1px solid var(--line);border-radius:var(--r);background:var(--surface);color:var(--ink);box-shadow:var(--shadow)}dialog::backdrop{background:var(--backdrop)}.dialog-inner{padding:clamp(1.4rem,4vw,2.4rem)}.close{position:sticky;float:right;top:.7rem;z-index:2}.dialog-inner h2{margin:.2rem 3.5rem 1rem 0;font:700 1.7rem Poppins,sans-serif}.dialog-inner p,.dialog-inner li{color:var(--soft)}footer{padding:2rem 0 3rem;border-top:1px solid var(--line);color:var(--soft);font-size:.78rem}
    @media(max-width:900px){.nav{display:none}.hero{grid-template-columns:1fr}.rail{display:none}.section-head,.role{grid-template-columns:1fr}.capabilities{grid-template-columns:1fr 1fr}}@media(max-width:620px){.shell{padding:0 18px}.demo{display:none}.proof{grid-template-columns:1fr}.proof article+article{border-left:0;border-top:1px solid var(--line)}.capabilities{grid-template-columns:1fr}.hero h1{font-size:clamp(2.55rem,15vw,4.2rem)}}
    @media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{animation:none!important;transition:none!important}}@media print{html[data-theme]{--bg:var(--career-option-canvas);--surface:var(--career-option-surface);--surface-2:var(--career-option-surface-raised);--ink:var(--career-option-text);--soft:var(--career-option-text-muted);--gold:var(--career-option-accent);--line:var(--career-option-line);color-scheme:light}body:before,.theme,.js .evidence-button,.nav,.demo{display:none!important}.shell{max-width:none}.top{min-height:54px}.section{break-inside:avoid}.role,.capabilities details{break-inside:avoid;box-shadow:none}}
  </style>
  <script>document.documentElement.classList.add('js');try{if(localStorage.getItem('mdg_cv_theme')==='light')document.documentElement.dataset.theme='light'}catch(e){}</script>
</head>
<body>
<a class="skip" href="#contenido">Saltar al contenido</a>
<header class="shell top"><div class="brand"><svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true"><path fill="currentColor" d="M3 26V6h5l8 11 8-11h5v20h-6V15l-7 9-7-9v11z"/></svg><span>MetodologIA · Career</span></div><nav class="nav" aria-label="Principal"><a href="#experiencia">Experiencia</a><a href="#resultados">Resultados</a><a href="#capacidades">Capacidades</a></nav><div class="actions"><span class="demo">Demo sintética</span><button class="theme" type="button" aria-label="Activar tema claro" aria-pressed="false" data-label-light="Activar tema claro" data-label-navy="Activar tema azul"><svg viewBox="0 0 24 24" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" d="M12 3v2m0 14v2M3 12h2m14 0h2M5.6 5.6 7 7m10 10 1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"/><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2"/></svg></button></div></header>
<main id="contenido" class="shell">
  <section class="hero" aria-labelledby="hero-title"><div><p class="eyebrow">Liderazgo de estrategia y transformación</p><h1 id="hero-title">Convierto complejidad en decisiones que avanzan.</h1><p class="lead">Diseño rutas de ejecución que conectan negocio, producto, transformación digital e IA aplicada para producir valor temprano, medible y acumulativo.</p></div><aside class="rail" aria-label="Cómo leer este perfil"><svg viewBox="0 0 48 48" aria-hidden="true"><path d="M8 12h32M8 24h22M8 36h28" fill="none" stroke="currentColor" stroke-width="3"/><circle cx="38" cy="24" r="4" fill="currentColor"/></svg><h2>Lectura en tres capas</h2><p>Propuesta, evidencia y profundidad bajo demanda.</p><ol><li>Escanee el alcance.</li><li>Revise decisiones.</li><li>Abra evidencia.</li></ol></aside></section>
  <section id="resultados" class="proof" aria-label="Señales de alcance ilustrativas"><article><strong>3 frentes</strong><span>Estrategia · producto · adopción</span><small>Escenario sintético</small></article><article><strong>12 semanas</strong><span>De reto priorizado a piloto medible</span><small>Ejemplo, no claim</small></article><article><strong>1 sistema</strong><span>Gobierno, delivery y aprendizaje</span><small>Modelo ilustrativo</small></article></section>
  <section id="experiencia" class="section"><div class="section-head"><span>01 · Experiencia</span><h2>Decisiones que ordenan la ejecución.</h2></div><div class="timeline"><article class="role"><div class="meta">Unidad sintética · Actual</div><div><h3>Dirección de transformación</h3><p>Priorizó una cartera dispersa, definió gobernanza y convirtió hipótesis en un piloto con criterios de continuidad explícitos.</p><button class="evidence-button" type="button" data-open="evidence"><svg width="18" height="18" viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="2"/></svg>Examinar evidencia</button><details class="evidence-source"><summary>Examinar evidencia</summary><p>Ejemplo sintético: trazabilidad entre reto, decisión, entregable y criterio de aceptación. No atribuye cifras ni organizaciones reales.</p></details></div></article><article class="role"><div class="meta">Producto sintético · Anterior</div><div><h3>Liderazgo de producto</h3><p>Alineó visión, discovery y operación alrededor de una métrica de adopción entendible por negocio y tecnología.</p></div></article></div></section>
  <section id="capacidades" class="section"><div class="section-head"><span>02 · Capacidades</span><h2>Facultades, no una lista de buzzwords.</h2></div><div class="capabilities"><details><summary>Estrategia operable</summary><p>Convierte ambición en decisiones, responsables, secuencia y señales de avance.</p></details><details><summary>IA aplicada</summary><p>Selecciona casos de uso por valor, viabilidad, riesgo y adopción.</p></details><details><summary>Diseño organizacional</summary><p>Alinea estructura, capacidades e incentivos con el modelo operativo.</p></details><details><summary>Dirección de producto</summary><p>Conecta discovery, roadmap y aprendizaje con resultados de negocio.</p></details><details><summary>Transformación digital</summary><p>Integra tecnología, proceso y cambio sin confundir actividad con avance.</p></details><details><summary>Liderazgo de unidades</summary><p>Gestiona dirección, operación y desempeño con responsabilidad integral.</p></details></div></section>
</main>
<dialog id="evidence" aria-labelledby="evidence-title"><div class="dialog-inner"><button class="close" type="button" aria-label="Cerrar evidencia"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2"/></svg></button><p class="eyebrow">Evidencia ilustrativa</p><h2 id="evidence-title">De la prioridad al aprendizaje verificable</h2><p>El patrón muestra cómo documentar una experiencia real sin inflar atribución:</p><ul><li>Reto y alcance delimitados.</li><li>Decisión y rol del candidato explícitos.</li><li>Resultado trazable a una fuente autorizada.</li><li>Límite declarado cuando falta evidencia.</li></ul></div></dialog>
<footer class="shell">Alternativa A · Blueprint Executive · Preview sintético · DESIGN_OPTIONS_READY</footer>
<script>(()=>{const root=document.documentElement,t=document.querySelector('.theme'),d=document.querySelector('#evidence'),open=document.querySelector('[data-open="evidence"]'),close=d.querySelector('.close');let lastFocus;const sync=()=>{const light=root.dataset.theme==='light';t.setAttribute('aria-pressed',String(light));t.setAttribute('aria-label',light?t.dataset.labelNavy:t.dataset.labelLight)};sync();t.addEventListener('click',()=>{root.dataset.theme=root.dataset.theme==='light'?'navy':'light';try{localStorage.setItem('mdg_cv_theme',root.dataset.theme)}catch(e){}sync()});open.addEventListener('click',()=>{lastFocus=open;d.showModal();close.focus()});close.addEventListener('click',()=>d.close());d.addEventListener('click',e=>{if(e.target===d)d.close()});d.addEventListener('keydown',e=>{if(e.key==='Tab'){e.preventDefault();close.focus()}});d.addEventListener('close',()=>lastFocus?.focus())})();</script>
</body>
</html>
