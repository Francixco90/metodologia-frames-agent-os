{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://metodologIA.dev/schemas/content-os/talking-head-recut-v1.schema.json",
  "title": "Talking Head Recut v1 request",
  "type": "object",
  "required": ["composition_id", "duration", "clip", "cards"],
  "properties": {
    "composition_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "duration": {"type": "number", "minimum": 1, "description": "clip duration in seconds"},
    "aspect": {"type": "string", "enum": ["16:9", "9:16", "4:5", "1:1"], "default": "16:9"},
    "clip": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "description": "local video file path"},
        "audio_extracted": {"type": "boolean", "default": false},
        "transcribed": {"type": "boolean", "default": false}
      }
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "kind", "content"],
        "properties": {
          "id": {"type": "string", "pattern": "^card-\\d{2}$"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0, "description": "must be > start and <= duration"},
          "kind": {
            "type": "string",
            "enum": ["title", "lower-third", "data-callout", "quote", "side-panel", "pip"]
          },
          "content": {"type": "string", "description": "HTML payload for the card"},
          "rationale": {"type": "string", "description": "why this card here"}
        }
      }
    }
  }
}
