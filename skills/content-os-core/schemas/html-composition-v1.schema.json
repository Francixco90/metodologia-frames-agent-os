{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metodologia.local/schemas/html-composition-v1.schema.json",
  "title": "HtmlCompositionV1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "compositionId",
    "width",
    "height",
    "fps",
    "durationInFrames",
    "clips"
  ],
  "properties": {
    "schemaVersion": {"const": "html-composition-v1"},
    "compositionId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{1,127}$"},
    "compositionPath": {"type": "string", "minLength": 1, "maxLength": 1024},
    "width": {"type": "integer", "exclusiveMinimum": 0},
    "height": {"type": "integer", "exclusiveMinimum": 0},
    "fps": {"type": "number", "exclusiveMinimum": 0, "maximum": 120},
    "durationInFrames": {"type": "integer", "minimum": 1, "maximum": 72000},
    "tracks": {"type": "array", "items": {"$ref": "#/$defs/track"}},
    "clips": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/clip"}},
    "variables": {"type": "array", "items": {"$ref": "#/$defs/variable"}},
    "media": {"type": "array", "items": {"$ref": "#/$defs/media"}},
    "renderPolicy": {"$ref": "#/$defs/renderPolicy"}
  },
  "$defs": {
    "portableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{1,127}$"},
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trackIndex"],
      "properties": {"trackIndex": {"type": "integer", "minimum": 0}}
    },
    "clip": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clipId", "trackIndex", "start", "duration"],
      "properties": {
        "clipId": {"$ref": "#/$defs/portableId"},
        "trackIndex": {"type": "integer", "minimum": 0},
        "start": {"type": "number", "minimum": 0},
        "duration": {"type": "number", "exclusiveMinimum": 0},
        "compositionSrc": {"type": "string", "minLength": 1}
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
        "value": {"type": ["string", "number", "boolean"]}
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mediaId", "kind", "src"],
      "properties": {
        "mediaId": {"$ref": "#/$defs/portableId"},
        "kind": {"enum": ["video", "audio", "image"]},
        "src": {"type": "string", "minLength": 1},
        "volume": {"type": "number", "minimum": 0, "maximum": 1},
        "trimStart": {"type": "number", "minimum": 0}
      }
    },
    "renderPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "networkRequests": {"const": 0},
        "randomness": {"const": false},
        "wallClock": {"const": false},
        "deterministicDoubleCapture": {"type": "boolean"}
      }
    }
  }
}
