{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://metodologIA.dev/schemas/content-os/music-to-video-v1.schema.json",
  "title": "Music to Video v1 request",
  "type": "object",
  "required": ["composition_id", "duration", "track", "frames"],
  "properties": {
    "composition_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "duration": {"type": "number", "minimum": 1, "description": "track duration in seconds"},
    "aspect": {"type": "string", "enum": ["16:9", "9:16", "1:1", "4:5"], "default": "16:9"},
    "track": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "description": "local audio file path (assets/bgm.mp3)"},
        "analyzed": {"type": "boolean", "default": false},
        "pacing": {
          "type": "string",
          "enum": ["beat", "phrase"],
          "description": "beat (rhythmic) or phrase (calm)"
        }
      }
    },
    "audiomap": {
      "type": "object",
      "properties": {
        "bpm": {"type": "number"},
        "beats_sec": {"type": "number"},
        "energy": {"type": "array", "items": {"type": "number"}},
        "onsets": {"type": "array", "items": {"type": "number"}},
        "silences": {"type": "array", "items": {"type": "number"}}
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "start", "end", "template"],
        "properties": {
          "id": {"type": "string", "pattern": "^frame-\\d{2}$"},
          "start": {"type": "number", "minimum": 0},
          "end": {"type": "number", "minimum": 0},
          "template": {"type": "string", "description": "template or motion-primitives combo"},
          "groups": {"type": "array", "items": {"type": "string"}},
          "pacing": {"type": "string", "enum": ["beat", "phrase"]}
        }
      }
    }
  }
}
