{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Workflow",
  "description": "Workflow compilado por P-01 a partir de intención en lenguaje natural",
  "type": "object",
  "required": ["graph_id", "version", "steps"],
  "additionalProperties": false,
  "properties": {
    "graph_id": {
      "type": "string",
      "description": "Identificador único del workflow (e.g., wf-001)"
    },
    "version": {
      "type": "string",
      "description": "Versión semántica del workflow"
    },
    "sampling_profile": {
      "type": "string",
      "enum": ["deterministic", "balanced", "creative"],
      "description": "Perfil de sampling. Default: deterministic."
    },
    "steps": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["id", "operation"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "description": "Identificador único del paso dentro del workflow"
          },
          "operation": {
            "type": "string",
            "enum": [
              "classify",
              "extract",
              "rewrite",
              "split",
              "compose",
              "factual_query",
              "generate",
              "ideate",
              "retrieve",
              "verify",
              "rank",
              "route",
              "tool",
              "redact",
              "human_approval"
            ],
            "description": "Operación NL-WF del catálogo cerrado de 15"
          },
          "inputs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Ids de pasos previos o etiquetas de input externo"
          },
          "retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 2,
            "description": "Reintentos locales permitidos para este paso"
          }
        }
      }
    },
    "branches": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4,
      "description": "Ramas paralelas declaradas en el DAG"
    },
    "model_calls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 12,
      "description": "Llamadas modelo estimadas para el workflow completo"
    }
  }
}